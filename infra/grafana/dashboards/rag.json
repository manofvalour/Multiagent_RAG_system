{
  "title": "RAG System Dashboard",
  "uid": "rag-system",
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Total Queries",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "rag_queries_total",
        "legendFormat": "Queries"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 2,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "rag_active_reqests",
        "legendFormat": "Active"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 3,
      "title": "Documents Ingested",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "rag_ingestion_total",
        "legendFormat": "Ingested"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 4,
      "title": "Vector Store Chunks",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "rag_vector_store_chunks",
        "legendFormat": "Chunks"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 5,
      "title": "Query Rate (per minute)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(rag_queries_total[1m]) * 60",
        "legendFormat": "Queries/min"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 6,
      "title": "Query Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(rag_query_latency_ms_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(rag_query_latency_ms_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(rag_query_latency_ms_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 7,
      "title": "Confidence Score Distribution (p50 / p95)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(rag_confidence_score_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(rag_confidence_score_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 8,
      "title": "Chunks Retrieved per Query (p50 / p95)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(rag_chunks_retrieved_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(rag_chunks_retrieved_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 9,
      "title": "Claims Verified Rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(rag_claim_verified_total[1m]) * 60",
        "legendFormat": "Claims/min"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 10,
      "title": "Avg Query Latency (ms)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{
        "expr": "rate(rag_query_latency_ms_sum[5m]) / rate(rag_query_latency_ms_count[5m])",
        "legendFormat": "Avg Latency ms"
      }],
      "datasource": "Prometheus"
    }
  ],
  "schemaVersion": 36,
  "time": {"from": "now-1h", "to": "now"}
}